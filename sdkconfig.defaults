# Enable the 2 MB PSRAM integrated in ESP32-D0WDR2-V3.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Give the interactive watch UI its full CPU budget.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# LVGL heart UI: anti-aliased fonts and chart/arc widgets.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_ARC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=96
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16

# CST816S responds on its touch event; avoid unsupported startup ID polling.
CONFIG_ESP_LCD_TOUCH_CST816S_DISABLE_READ_ID=y
